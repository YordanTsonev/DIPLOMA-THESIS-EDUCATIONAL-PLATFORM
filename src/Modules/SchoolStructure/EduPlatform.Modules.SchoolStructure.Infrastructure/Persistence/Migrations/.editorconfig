# EF Core writes the files in this folder; they are regenerated by tooling and are not
# hand-maintained. Holding generated code to the project's style rules would mean editing
# each migration after every scaffold, and those edits would be lost on the next one.
[*.cs]
generated_code = true

dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
