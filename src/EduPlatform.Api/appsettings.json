{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=eduplatform;Username=eduplatform;Password=dev;Include Error Detail=true",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "EduPlatform.Api"
    }
  },
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "eduplatform-client",
    "AccessTokenLifetime": "00:15:00"
  },
  "Identity": {
    "RefreshTokenLifetime": "14.00:00:00",
    "EmailConfirmationLifetime": "3.00:00:00",
    "PasswordResetLifetime": "02:00:00",
    "ClientBaseUrl": "http://localhost:4200",
    "FromAddress": "no-reply@eduplatform.local",
    "FromName": "EduPlatform"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false
  }
}
