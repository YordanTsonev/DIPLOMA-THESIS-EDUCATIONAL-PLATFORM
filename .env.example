# Copy this file to .env and adjust for your machine.
# .env is git-ignored; never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_DB=eduplatform
POSTGRES_USER=eduplatform
POSTGRES_PASSWORD=dev
# 5433, not 5432: a locally installed PostgreSQL service may already own 5432.
POSTGRES_PORT=5433

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Mailpit ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Seq ----
SEQ_UI_PORT=5341
SEQ_INGESTION_PORT=5342

# ---- Embeddings (profile: ai, used from Phase 8) ----
EMBEDDINGS_PORT=8080

# ---- Application ----
# Generate a key with: openssl rand -base64 48
JWT__KEY=change-me-this-is-a-development-only-signing-key-min-32-bytes
ANTHROPIC__APIKEY=
